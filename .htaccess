# KFZ-Zulassungsprofis – Server-Konfiguration (all-inkl/Apache)
# Wird beim Build aus public/ mit ins Webroot der Domain kfz-zulassungsprofis.de deployt.
# Die frühere Domain deutschezulassung.de hat eine eigene, reine Weiterleitungs-Datei:
# deploy/alte-domain/.htaccess (siehe docs/migration/MIGRATION.md).

# ── Eigene Fehlerseite (Next.js exportiert out/404.html) ──────────────
ErrorDocument 404 /404.html

# ── Zeichensatz für Text-Dateien (z. B. /llms.txt) ────────────────────
AddDefaultCharset UTF-8
AddCharset utf-8 .txt

# ── OG-Bilder: Next.js exportiert sie ohne Dateiendung ────────────────
# Ohne explizite Typangabe liefert Apache sie zusammen mit "nosniff" falsch aus.
<FilesMatch "^(opengraph-image|twitter-image|apple-icon)$">
  ForceType image/png
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── Themen-Weiterleitungen: gleicher Suchintent → eine starke Seite ──
  # Siehe lib/landingpages.ts und config/migration.json. Keine Duplikat-Seiten
  # anlegen, sondern hierher leiten. Ziele bewusst mit vollständiger Adresse:
  # so entsteht auch von www oder der früheren Domain aus nur ein Sprung.
  RewriteRule ^auto-online-zulassen-ohne-eid/?$ https://kfz-zulassungsprofis.de/kfz-zulassung-ohne-eid/ [R=301,L]
  RewriteRule ^kfz-zulassung-ohne-ausweisapp/?$ https://kfz-zulassungsprofis.de/kfz-zulassung-ohne-eid/ [R=301,L]
  RewriteRule ^online-zulassung-funktioniert-nicht/?$ https://kfz-zulassungsprofis.de/ikfz-funktioniert-nicht/ [R=301,L]
  RewriteRule ^kfz-zulassung-kosten/?$ https://kfz-zulassungsprofis.de/ratgeber/was-kostet-eine-kfz-zulassung/ [R=301,L]

  # ── Kanonische Domain: www und frühere Domain → kfz-zulassungsprofis.de ──
  # Die frühere Domain landet nur hier, falls sie im KAS auf denselben Ordner
  # zeigt; im Normalfall leitet ihre eigene .htaccess schon vorher weiter.
  # Formular-Endpunkt mit 308, damit eine laufende Übermittlung (POST) erhalten bleibt.
  RewriteCond %{HTTP_HOST} ^(www\.kfz-zulassungsprofis\.de|(www\.)?deutschezulassung\.de)$ [NC]
  RewriteRule ^(api/.*)$ https://kfz-zulassungsprofis.de/$1 [R=308,L]

  RewriteCond %{HTTP_HOST} ^(www\.kfz-zulassungsprofis\.de|(www\.)?deutschezulassung\.de)$ [NC]
  RewriteRule ^(.*)$ https://kfz-zulassungsprofis.de/$1 [R=301,L]
</IfModule>

# ── Security-Header ───────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # CSP: Next.js braucht Inline-Skripte/-Styles; keine externen Quellen im Einsatz.
  # Wird Webanalyse oder Google Ads aktiviert (lib/analytics.ts), müssen deren
  # Hosts hier ergänzt werden – siehe docs/TRACKING.md.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://wa.me"

  # ── Caching: gehashte Build-Assets dürfen aggressiv gecacht werden ──
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
