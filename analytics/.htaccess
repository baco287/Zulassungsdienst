# Analytics-Dashboard (nur mit Login, siehe api/analytics-lib.php)
DirectoryIndex index.php

# Die Oberfläche wird nur über index.php (nach dem Login) ausgeliefert.
<Files "dashboard.html">
  Require all denied
</Files>

# Läuft PHP als FastCGI, reicht Apache den Login-Kopf sonst nicht an PHP weiter.
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Cache-Control "no-store"
  # Wie die Website, zusätzlich Chart.js von jsDelivr (nur hier im Admin-Bereich).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
