# KI-Assistent: Admin-Bereich (nur mit Login, siehe intern/Admin.php)
DirectoryIndex index.php

# Die Oberfläche wird nur über index.php (nach dem Login) ausgeliefert.
<Files "admin.html">
  Require all denied
</Files>

# Läuft PHP als FastCGI, reicht Apache den Login-Kopf sonst nicht an PHP weiter.
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Cache-Control "no-store"
  # Strenger als die Website: kein Inline-Skript, kein Inline-Stil, keine fremden Quellen.
  # Hier werden Texte von Unbekannten angezeigt (Kundenmails) – selbst wenn einmal etwas
  # davon als HTML in die Seite geriete, liefe es nicht als Skript. Dieselbe Zeile steht
  # in intern/Admin.php (Admin::CSP); beide zusammen ändern.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

  # Die Website erlaubt für .js und .css ein Jahr Zwischenspeicher (public/.htaccess, dort
  # tragen die Dateien einen Hash im Namen). admin.js und admin.css heißen immer gleich:
  # Ohne diese Zeile bekäme ein Browser nach einem Update noch ein Jahr lang die alte Fassung.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
