    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "anthropic-ai/sdk": "^1.12",
        "directorytree/imapengine": "^1.26",
        "guzzlehttp/guzzle": "^8.5"
    },
    "config": {
        "platform": { "php": "8.5.0" },
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": false
    }
}
